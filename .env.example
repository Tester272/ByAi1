# MobileAgent server configuration (all optional - you can also set keys per-request from the app)

# HTTP port
PORT=8787

# Where the SQLite database lives
DATA_DIR=./data

# Optional server-side default LLM provider. Users can override these from the
# app's Settings screen (bring-your-own-key).
LLM_PROVIDER=openai          # openai | anthropic | gemini | openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=                # only for openai-compatible providers

# Optional: Composio key so the agent can drive 500+ apps (Gmail, Slack, GitHub...)
COMPOSIO_API_KEY=

# Optional search upgrade (falls back to DuckDuckGo when unset)
TAVILY_API_KEY=

# Max agent steps per turn (guards runaway loops)
MAX_STEPS=25
